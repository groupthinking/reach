# PostgreSQL
POSTGRES_DB=reach
POSTGRES_USER=reach_user
POSTGRES_PASSWORD=reach_pass
DATABASE_URL=postgres://reach_user:reach_pass@postgres:5432/reach

# Relay
RELAY_URL=ws://localhost:8080/ws
RELAY_COMMUNITY_ID=
RELAY_CHANNEL_ID=
RELAY_KEYPAIR=

# Audio Flamingo
MODEL_BACKEND=af3
HF_TOKEN=
RELAY_WEBHOOK_URL=

# API Gateway
PORT=3000
AUDIO_SERVICE_URL=http://localhost:8000
CES_DEPLOYMENT_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Widget
VITE_CES_DEPLOYMENT_NAME=projects/YOUR_PROJECT/locations/YOUR_REGION/apps/YOUR_APP/deployments/YOUR_DEPLOYMENT
VITE_MODALITY=mixed
VITE_API_GATEWAY_URL=http://localhost:3000
