/* Tamarin authorization model stub for Buzz multi-tenant relay. */

theory MultiTenantAuth
begin

builtins: signing, hashing

rule Relay_Send_Challenge:
    [ Fr(~challenge) ]
  --[ Challenge(~challenge) ]-->
    [ Out(~challenge), RelayState(~challenge) ]

rule Client_Auth_Response:
    [ In(challenge), Fr(~sk) ]
  --[ ClientAuth(pk(~sk), challenge) ]-->
    [ Out(sign(<'AUTH', challenge, pk(~sk)>, ~sk)), ClientKey(~sk) ]

rule Relay_Verify_Auth:
    [ RelayState(challenge), In(sign(<'AUTH', challenge, pubkey>, sk)) ]
  --[ Verified(pubkey, challenge), AuthBound(pubkey) ]-->
    [ RelayAuthed(pubkey) ]

rule Client_NIP98_Token:
    [ ClientKey(~sk), Fr(~token_id) ]
  --[ TokenCreated(~token_id, pk(~sk)) ]-->
    [ Out(sign(<'NIP98', ~token_id, pk(~sk)>, ~sk)) ]

rule Relay_Verify_NIP98:
    [ In(sign(<'NIP98', token_id, pubkey>, sk)), !SeenSet(token_id) ]
  --[ TokenUsed(token_id, pubkey) ]-->
    [ !SeenSet(token_id) ]

lemma S1_NoForge:
    "All pubkey event #i.
     Verified(pubkey, event) @ i
     ==> Ex sk #j. ClientKey(sk) @ j & pk(sk) = pubkey"

lemma S2_NoReplay:
    "All token_id pubkey #i #j.
     TokenUsed(token_id, pubkey) @ i &
     TokenUsed(token_id, pubkey) @ j
     ==> #i = #j"

lemma S6_PubkeyBinding:
    "All pubkey challenge #i.
     Verified(pubkey, challenge) @ i
     ==> Ex #j. ClientAuth(pubkey, challenge) @ j & #j < #i"

end
